        </div>

        <!-- Flop -->
        <div class="border rounded p-4 flex-1">
          <h3 class="text-xl font-semibold mb-4">Flop</h3>
          
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium mb-1">Card 1</label>
