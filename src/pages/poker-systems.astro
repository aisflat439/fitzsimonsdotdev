      </div>

      <button type="button" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
        Run Simulation
      </button>
    </section>
    
    <script>
      const positions6Max = ['UTG', 'MP', 'CO', 'BTN', 'SB', 'BB'];
      const positions9Max = ['UTG', 'UTG+1', 'MP', 'MP+1', 'LJ', 'HJ', 'CO', 'BTN', 'SB', 'BB'];
      
      const playersSelect = document.getElementById('players') as HTMLSelectElement;
      const positionSelect = document.getElementById('position') as HTMLSelectElement;
      const villainSelect = document.getElementById('villain') as HTMLSelectElement;
      
      function updatePositions() {
        const playerCount = parseInt(playersSelect.value);
        const positions = playerCount === 6 ? positions6Max : positions9Max;
        
        const currentPosition = positionSelect.value;
        positionSelect.innerHTML = positions.map(pos => `<option value="${pos}">${pos}</option>`).join('');
        
        // Restore selection if valid
        if (positions.includes(currentPosition)) {
          positionSelect.value = currentPosition;
        }
      }
      
      function updateVillainPositions() {
        const playerCount = parseInt(playersSelect.value);
        const positions = playerCount === 6 ? positions6Max : positions9Max;
        const heroPosition = positionSelect.value;
        
        const availablePositions = positions.filter(pos => pos !== heroPosition);
        const currentVillain = villainSelect.value;
        villainSelect.innerHTML = availablePositions.map(pos => `<option value="${pos}">${pos}</option>`).join('');
        
        // Restore selection if valid, otherwise default to BB
        if (availablePositions.includes(currentVillain)) {
          villainSelect.value = currentVillain;
        } else if (availablePositions.includes('BB')) {
          villainSelect.value = 'BB';
        }
      }
      
      playersSelect.addEventListener('change', () => {
        updatePositions();
        updateVillainPositions();
      });
      
      positionSelect.addEventListener('change', updateVillainPositions);
      
      // Initialize on load
      updatePositions();
      updateVillainPositions();
    </script>

    <section>
      <h2 class="text-2xl font-semibold mb-4">Results</h2>
      <div class="results-area">
        <!-- Results will appear here -->
      </div>
    </section>
  </main>
</Layout>
