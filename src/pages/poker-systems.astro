---
import Layout from '../layouts/Layout.astro';

const positions6Max = ['UTG', 'MP', 'CO', 'BTN', 'SB', 'BB'];
const positions9Max = ['UTG', 'UTG+1', 'MP', 'MP+1', 'LJ', 'HJ', 'CO', 'BTN', 'SB', 'BB'];
---

<Layout title="Poker Systems">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">Poker Monte Carlo Simulation</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-4">Simulation Parameters</h2>
      
      <div class="flex flex-row gap-4 mb-8 w-full">
        <!-- Preflop -->
        <div class="border rounded p-4 flex-1">
          <h3 class="text-xl font-semibold mb-4">Preflop</h3>
          
          <div class="space-y-4">
            <div class="flex gap-2">
              <div class="flex-1">
                <label class="block text-sm font-medium mb-1 whitespace-nowrap">Players</label>
                <select id="players" class="w-full border rounded px-3 py-2">
                  <option value="6">6</option>
                  <option value="9" selected>9</option>
                </select>
              </div>
              
              <div class="flex-1">
                <label class="block text-sm font-medium mb-1 whitespace-nowrap">Position</label>
                <select id="position" class="w-full border rounded px-3 py-2">
                </select>
              </div>
              
              <div class="flex-1">
                <label class="block text-sm font-medium mb-1 whitespace-nowrap">Villain</label>
                <select id="villain" class="w-full border rounded px-3 py-2">
                </select>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-1">Your Card 1</label>
              <div class="flex gap-2">
                <select class="flex-1 border rounded px-3 py-2">
                  <option value="">Rank</option>
                  <option>A</option>
                  <option>K</option>
                  <option>Q</option>
                  <option>J</option>
                  <option>T</option>
                  <option>9</option>
