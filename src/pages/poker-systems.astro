                <select class="flex-1 border rounded px-3 py-2">
                  <option value="">Suit</option>
                  <option>♠</option>
                  <option>♥</option>
                  <option>♦</option>
                  <option>♣</option>
                </select>
              </div>
            </div>
            
            <div>
              <label class="block text-sm font-medium mb-1">Your Card 2</label>
              <div class="flex gap-2">
                <select class="flex-1 border rounded px-3 py-2">
                  <option value="">Rank</option>
                  <option>A</option>
